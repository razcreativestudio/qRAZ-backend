# QRAZ Backend Environment Variables

# MongoDB Atlas Connection String
# Get this from: https://cloud.mongodb.com/
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/qraz?retryWrites=true&w=majority

# Server Port
PORT=3000

# Frontend URL (for CORS)
FRONTEND_URL=https://raz.my.id

# Base URL for generated short links
# This should be your deployed backend URL
BASE_URL=http://localhost:3000

# Node Environment
NODE_ENV=development
