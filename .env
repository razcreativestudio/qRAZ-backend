# QRAZ Backend Environment Variables (Development)

# MongoDB Atlas Connection String - REPLACE WITH YOUR ACTUAL CONNECTION STRING
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/qraz?retryWrites=true&w=majority

# Server Port
PORT=3000

# Frontend URL (for CORS) - localhost for development
FRONTEND_URL=http://localhost

# Base URL for generated short links
BASE_URL=http://localhost:3000

# Node Environment
NODE_ENV=development
